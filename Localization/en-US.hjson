Mods: {
	KirboMod: {
		CommonItemTooltip: {
			DefenseVariesDamage: Damage varies with the amount of defense you have
			DefensePenetration: Ignores {0} points of enemy defense
			IgnoresDefense: Ignores enemy defense completely
			MusicBoxTitle: Music Box
			NightStarDamageMult: "[i:4060] Super Star Shooter's slashes will deal {0}x damage as opposed 0.75x"
			ShroomiteHelmetBenefitDowngrades: This weapon and its downgrades benefit from the [i:1548] Shroomite Helmet
			ShroomiteHelmetBenefit: This weapon benefits from the [i:1548] Shroomite Helmet
			UnimplementedAbilityHat: "'What could've been...'"
			Unobtainable: Currently unobtainable
		}

		ProgressionDescription: {
			Whispy: Place down a [i:{0}] and right click it in a large, flat area.
			Kracko: Kill a naturally spawning Kracko Jr. or use a [i:{0}] to summon one.
			Dedede: Use a [i:{0}].
			Nightmare: Use a [i:{0}] at a Fountain of Dreams during night.
			DarkMatter: Use a [i:{0}].
			Marx: Use a [i:{0}].
			Zero: Use a [i:{0}] and prepare for what comes next.
		}

		DespawnMessage: {
			Whispy: Whispy Woods retreats back into the ground...
			Kracko: Kracko floats back up into the heavens...
			Dedede: The King gives up the chase...
			Nightmare: The nightmare has passed...
			DarkMatter: It slips back into the shadows...
			Marx: I'm hungry! I'll conquer the world another time...
			Zero: The darkness clears...
		}

		Achievements: {
			WhispyAchievement: {
				Description: Defeat the self-elected guardian of the forest who grew from the wishes of another world.
				FriendlyName: Like a Whisper
			}

			KrackoAchievement: {
				Description: Defeat the thundering menace who controls the skies with swiftness and lightning.
				FriendlyName: Not All it's Kracked Up to be
			}

			KingDededeAchievement: {
				Description: Defeat the larger-than-life ruler aimlessly wandering the land after being carried from his throne into another dimension.
				FriendlyName: Star of the Show!
			}

			NightmareAchievement: {
				Description: Defeat the shadowy terror who haunts the night when a deposit of dreams makes itself known.
				FriendlyName: Dream Once More
			}

			MarxAchievement: {
				Description: Defeat the maniacal magician who attempted to gain power through cunning trickery and paitent planning.
				FriendlyName: Super Ultra Schemer
			}

			DarkMatterAchievement: {
				Description: Defeat the ruthless invader of unknown origin who carries with it an ominous darkness.
				FriendlyName: Let There be Light
			}

			ZeroAchievement: {
				Description: Defeat the re-reborn form of darkness incarnate and prove yourself as a worthy champion of all that is good.
				FriendlyName: Back to Zero
			}

			MidBossAchievement: {
				Description: Defeat an almost-mighty foe forced into your world through a star-shaped rift.
				FriendlyName: Boss in Training
			}

			EnemiesAchievement: {
				Description: Defeat every basic enemy and mid-boss in Kirby's Terraria Mod.
				FriendlyName: Popstar Popper
			}

			RareStoneAchievement: {
				Description: Obtain a rare stone, a valuable artifact recovered from a powerful foe crossing between dimensions.
				FriendlyName: I Like My Stones Rare
			}

			EvoWeaponAchievement: {
				Description: Use a rare stone to upgrade a weapon beyond its base potential.
				FriendlyName: Level Up!
			}

			ThirdTierAchievement: {
				Description: Bring a weapon up to its third evolution with rare stones.
				FriendlyName: To go Even Further Beyond!
			}

			RainbowSwordAchievement: {
				Description: Use all the colors of the world to craft a blade that unifies them against the dark.
				FriendlyName: Spectrum
			}

			ZeroWeaponAchievement: {
				Description: Craft a supreme, darkness-defying weapon with the matter of the darkest being.
				FriendlyName: Seal the Darkness
			}
		}

		DropConditions: {
			PostGolem: In Hardmode, post-Golem
			PreGolem: In Hardmode, pre-Golem
			WaddleDoo: Not from a minion
		}

