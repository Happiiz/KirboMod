			}

			StarshipMount: {
				Description: Set sail toward the sparkling star of hope!
				DisplayName: Starship
			}

			MarxPetBuff: {
				Description: The only wish this nova can grant is mild comfort
				DisplayName: Mini Nova
			}
		}

		Items: {
			KirbyBalloon: {
				DisplayName: Pink Balloon
				Tooltip: You can jump infinitely!
			}

			NightCloak: {
				DisplayName: Night Cloak
				Tooltip:
					'''
					Summons homing stars when hit, their numbers based on damage taken
					The stars have a combined damage value of 3x the damage taken
					Each star ignores 40 defense each
					In PVP, all stars spawn with 3x damage taken each
					Stars spawned from PVP cannot hit enemies and vice-versa
					Does not activate from damage taken from spikes, lava, and using a regular bug net on hell critters
					'''
			}

