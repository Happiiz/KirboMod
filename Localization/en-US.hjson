			SkyBlanket: {
				DisplayName: Sky Blanket
				Tooltip:
					'''
					Calls on Kracko Jr.
					'I need my blankey!'
					'''
			}

			Starbit: {
				DisplayName: Starbit
				Tooltip: A physical fragment of a burning wish
			}

			ArcherBow: {
				DisplayName: One Shot Bow
				Tooltip:
					'''
					Converts star arrows into charged star arrows
					Charged star arrows have a small homing range, deal 1.15x damage, and travel faster
					Converts all other arrows into jester's arrows
					'''
			}

			BallsofMatter: {
				DisplayName: Dark Petal
				Tooltip:
					'''
					Springs out then moves towards mouse position
					{$CommonItemTooltip.ShroomiteHelmetBenefit}
					'''
			}

			BeamStaff: {
				DisplayName: Beam Staff
				Tooltip:
					'''
					High damage, high knockback, high piercing, ease of aim, at the cost of range and high mana use
					'Beam Attack!'
					'''
			}

			Blado: {
				DisplayName: Blado
				Tooltip: Lands on the ground and then spins forward
			}

			BlizzardIce: {
				DisplayName: Blizzard Ice Pot
				Tooltip:
					'''
					Fires a volley of icicles
					Icicles that touch any enemy cause them to grow damaging ice on their body
					Killing an enemy transforms them into ice cubes
					Icicles that land on the ground spike giant ice formations
					The formations do not transform enemies into icicles upon killing them
					'''
			}

			Bomb: {
				DisplayName: Jolly Bomb
				Tooltip: Detonate after a while or upon contact with an enemy
			}

			BuzzCutter: {
				DisplayName: Buzz-Saw Cutter
				Tooltip:
					'''
					Shoots flying sawblades that bounce off walls and grind against enemies
					{$CommonItemTooltip.IgnoresDefense}
					{$CommonItemTooltip.ShroomiteHelmetBenefitDowngrades}
					'''
			}

			ChainBomb: {
				DisplayName: Chain Bomb
				Tooltip:
					'''
					Detonate after a while or upon contact with an enemy
					Links to nearby chain bombs, increasing power the more bombs are linked
					Detonates linked chain bombs upon explosion
					'''
			}

			ChakramCutter: {
				DisplayName: Chakram Cutter
				Tooltip:
					'''
					Shoots 2 chakrams
					After a bit, they hover in place for a brief moment, shoot outwards in the opposite directions, and return to you
					'''
			}

			CleaningBroom: {
				DisplayName: Cleaning Broom
				Tooltip:
					'''
					Swing on the ground to kick up dust toward the cursor
					'Sweep, sweep, sweep!'
					'''
			}

			ClutterNeedle: {
				DisplayName: Clutter Needle Ball
				Tooltip:
					'''
					Rolls on the ground
					Creates a lot of bouncing clutter over time
					Explodes into 20 clutter projectiles after a while
					All clutter deals full damage
					'''
			}

			CrownOfClimate: {
				DisplayName: Crown Of Climate
				Tooltip:
					'''
					Summons a burning leo and chilly combo to fight for you
					'lol the damage value is so low how good could it really be'
					'''
			}

			CrownOfFire: {
				DisplayName: Crown Of Fire
				Tooltip: Summons a burning leo to fight for you
			}

			CrownOfIce: {
				DisplayName: Crown Of Ice
				Tooltip:
					'''
					Summons a chilly to fight for you
					{$CommonItemTooltip.DefensePenetration}
					'''
			}

			CrystalGun: {
				DisplayName: Ribbon's Crystal
				Tooltip:
					'''
					Homes in on enemies very strongly
					Consumes special [i:KirboMod/CrystalShard] otherwordly crystal shards. (not [i:502])
					75% chance to not consume ammo
					This weapon benefits from the [i:1548] Shroomite Helmet
					'''
			}

			CrystalNeedle: {
				DisplayName: Crystal Needle Ball
				Tooltip:
					'''
					Leaves crystals along the ground
					Shoots crystal spikes out when expired
					{$CommonItemTooltip.ShroomiteHelmetBenefitDowngrades}
					'''
			}

			Cutter: {
				DisplayName: Cutter
				Tooltip: Turns in the opposite direction horizontally after a bit
			}

			CyborgArcherBow: {
				DisplayName: Bot Shot
				Tooltip:
					'''
					Converts star arrows into a laser beam & four extra laser arrows
					Converts all other arrows into laser arrows
					Laser arrows ignore 25 defense and pierce 9 times with 5% falloff
					Laser beam pierces infinitely
					'''
			}

			DarknessRay: {
				DisplayName: Darkness Ray
				Tooltip: Fires a dark laser that zips through the sky
			}

			DarkSword: {
				DisplayName: Dark Sword
				Tooltip: Fires dark beams, dark orbs, and large dark waves
			}

			DooStaff: {
				DisplayName: Doo Staff
				Tooltip:
					'''
					Summons a waddle doo to fight for you
					'Beam Attack!'
					'''
			}

			DragonFire: {
				DisplayName: Dragon Pot
				Tooltip:
					'''
					Unleashes a flurry of dragon flames
					Enemies hit by them will be set on dragon fire
					{$CommonItemTooltip.DefensePenetration}
					'''
			}

			DreamRod: {
				DisplayName: Dream Rod
				Tooltip:
					'''
					Use the power of your friends to defeat evil doers!
					Effectiveness of friends increases with the more minion slots you have
					'''
			}

			FighterGlove: {
				DisplayName: Fighter Glove
				Tooltip:
					'''
					Land punches to build up charge
					Right click to use all stored charge and perform an uppercut (has a cooldown only in the air)
					The uppercut deals more damage the more charge you use
					If you use more than half of the maximum charge at once, the uppercut will travel further and make you invincible
					{$CommonItemTooltip.DefensePenetration}
					'''
			}

			FinalCutter: {
				DisplayName: Final Cutter
				Tooltip:
					'''
					Flies in the opposite direction
